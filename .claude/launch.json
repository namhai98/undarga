{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@undarga/web",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@undarga/api",
        "start:dev"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@undarga/web",
        "exec",
        "dotenv",
        "-e",
        "../../.env",
        "--",
        "next",
        "start",
        "--port",
        "3005"
      ],
      "port": 3005
    }
  ]
}
