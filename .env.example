# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# NODE_ENV is deliberately NOT set here.
#
# Each tool sets its own: "next build" sets production, "next dev" sets
# development, jest sets test. Pinning it here made dotenv-cli force
# development into production builds. The API config schema defaults it to
# development, so local runs are unaffected.
PORT=3000
API_PREFIX=api
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
#
# Two URLs, two Postgres roles. This separation is a security control, not a
# convenience:
#
#   DATABASE_URL          -> app_tenant   : RLS ENFORCED. All request traffic.
#   PLATFORM_DATABASE_URL -> app_platform : BYPASSRLS. Platform module, tenant
#                                           directory lookups, worker claim
#                                           queries, migrations. Nothing else.
#
# Never point DATABASE_URL at the platform role. A startup check refuses to
# boot if the tenant role can bypass RLS.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://app_tenant:app_tenant_dev@localhost:5432/undarga?schema=public
PLATFORM_DATABASE_URL=postgresql://app_platform:app_platform_dev@localhost:5432/undarga?schema=public
# Used only by `prisma migrate` / `prisma db push`; owns the schema.
MIGRATION_DATABASE_URL=postgresql://undarga:undarga_dev@localhost:5432/undarga?schema=public

# Connection pooling. MUST be `transaction` when pgbouncer sits in front.
DB_POOLING_MODE=transaction

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
#
# NOTE: there is deliberately no JWT_REFRESH_SECRET. Refresh tokens are opaque
# 256-bit values stored as an HMAC (see TOKEN_HASH_PEPPER below), not JWTs, so
# they can be revoked server-side — a signed refresh JWT cannot be.
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# HMAC pepper for refresh tokens and gift-card codes. Rotating it invalidates
# every outstanding refresh token.
TOKEN_HASH_PEPPER=change-me-dev-only-pepper

# How long an invitation link stays valid.
INVITATION_TTL_DAYS=7

# Password policy. Length is what resists guessing; composition rules mostly
# produce "Password1!". 12 is also the floor — this cannot be set lower.
PASSWORD_MIN_LENGTH=12

# One-time link lifetimes. Reset is far shorter than verification because it
# takes over an account: a leaked inbox should be dangerous for minutes, not days.
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---------------------------------------------------------------------------
# Tenant resolution
#
# Resolvers run as a priority chain. The route param and the token's active
# company are always on. The two host-based strategies are wired but disabled:
# turning them on requires the DNS verification flow, which is not built yet.
# ---------------------------------------------------------------------------
TENANT_RESOLVER_ROUTE_PARAM=true
TENANT_RESOLVER_ACTIVE_COMPANY=true
TENANT_RESOLVER_HEADER=true
TENANT_RESOLVER_CUSTOM_DOMAIN=false
TENANT_RESOLVER_SUBDOMAIN=false
# Apex used to strip a subdomain, e.g. "acme.booking.local" -> slug "acme".
TENANT_SUBDOMAIN_ROOT=booking.local

# Membership + permission cache (in-memory by default; swap for Redis in prod).
TENANT_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Audit
#
# Hash chaining makes tampering detectable but serializes audit writes per
# company behind an advisory lock. Benchmark before disabling.
# ---------------------------------------------------------------------------
AUDIT_HASH_CHAIN=true


# ---------------------------------------------------------------------------
# Availability
#
# Advisory response cache for the availability engine. 0 disables it, which is
# the default — the engine loads a bounded set of rows and computes in memory,
# so caching is a benchmark-driven optimisation, not a correctness need. If
# enabled, keep it SHORT: a slot list goes stale the moment an appointment is
# created.
# ---------------------------------------------------------------------------
AVAILABILITY_CACHE_TTL_SECONDS=0


# ---------------------------------------------------------------------------
# Notifications
#
# The in-process worker: outbox -> notifications -> providers, plus reminder
# scheduling. Provider setup: docs/NOTIFICATION-PROVIDERS.md.
# ---------------------------------------------------------------------------
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=15000

# Who sends for companies without their own account.
#   none      nothing is sent on that channel (the default in production)
#   log       development only: written to the API log (the default elsewhere)
#   mock      automated tests only
#   sendgrid / twilio   real delivery; refused in production: log, mock
EMAIL_PROVIDER=log
SMS_PROVIDER=log
# No device registration exists yet, so push stays off.
PUSH_PROVIDER=none

# SendGrid (EMAIL_PROVIDER=sendgrid). The key needs the "Mail Send" scope; the
# from address must be a verified sender or on an authenticated domain.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
SENDGRID_API_KEY=
# Optional: Settings > Mail Settings > Event Webhook > Signed Event Webhook,
# "Verification Key". Enables DELIVERED / bounce receipts.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# Twilio (SMS_PROVIDER=twilio). Give a from number OR a Messaging Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# This API's public origin (no path), e.g. https://api.example.com. Needed for
# delivery receipts; without it messages are tracked to "accepted" only.
NOTIFICATION_WEBHOOK_BASE_URL=

# 32 random bytes, base64, to encrypt companies' own provider credentials:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it companies cannot connect their own SendGrid / Twilio accounts.
# Changing it makes stored credentials unreadable (companies re-enter them).
SECRETS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Calendar integration (docs/CALENDAR-INTEGRATION.md)
#
# One-way: appointments are written to employees' Google / Outlook calendars,
# and busy times can be read back to block bookings. A provider without both
# values below cannot be connected. Calendar tokens are encrypted with
# SECRETS_ENCRYPTION_KEY (above), which is required too.
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# common (any account) | organizations | consumers | a tenant id
MICROSOFT_CALENDAR_TENANT=common
# Must be registered with each provider exactly. Default: WEB_APP_URL + /calendar/callback
CALENDAR_OAUTH_REDIRECT_URL=
CALENDAR_SYNC_ENABLED=true
CALENDAR_SYNC_INTERVAL_MS=30000
CALENDAR_BUSY_REFRESH_MINUTES=10

# ---------------------------------------------------------------------------
# Subscriptions
#
# The sweep that expires ended trials and cancelled periods, renews active
# ones (issuing the next invoice) and marks unpaid invoices past due.
# ---------------------------------------------------------------------------
SUBSCRIPTION_SWEEP_ENABLED=true
SUBSCRIPTION_SWEEP_INTERVAL_MS=3600000

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=undarga:
# When false the API starts without Redis and readiness reports it down.
# Forced true in production: rate limiting and booking holds fail OPEN without
# it, and a rate limiter that fails open is worse than one that refuses to boot.
REDIS_REQUIRED=false

# ---------------------------------------------------------------------------
# CORS
#
# Comma-separated exact origins (scheme://host[:port], no path, no wildcard).
# Empty means same-origin only; production refuses to boot with it empty, and
# requires https:// origins. Also the allow-list for the Origin check on the
# cookie-authenticated refresh/logout endpoints.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# Reverse proxy
# How many proxies in front of the API to trust for the client address
# (X-Forwarded-For). Unset = none. Behind one load balancer, set 1. Without it,
# every request looks like it came from the balancer: per-IP rate limits then
# lock everyone out together and audit logs record the wrong address.
# "true" is refused (it would let clients pick their own address).
# ---------------------------------------------------------------------------
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# OpenAPI
# The document enumerates every route and error code. Unset means on in
# development and OFF in production; set true in production only for a
# deliberately public API.
# ---------------------------------------------------------------------------
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Logging and rate limiting
# LOG_FORMAT: json (one object per line, the production default) or text
# (coloured, the development default). LOG_LEVEL: fatal|error|warn|info|debug|trace.
# THROTTLE_ENABLED stays on; production refuses false. Tests switch it off.
# ---------------------------------------------------------------------------
# LOG_FORMAT=text
# THROTTLE_ENABLED=true

# ---------------------------------------------------------------------------
# Database role passwords (scripts/apply-hardening.js)
# The hardening step sets the passwords of app_tenant and app_platform. Unset
# here they default to the development values above; production refuses to run
# without both (use the passwords in DATABASE_URL / PLATFORM_DATABASE_URL).
# ---------------------------------------------------------------------------
# APP_TENANT_PASSWORD=
# APP_PLATFORM_PASSWORD=

# ---------------------------------------------------------------------------
# Web app origin
#
# Used to build the invitation accept link. Deliberately configured rather than
# derived from the request Host header: host-header injection would otherwise
# produce an invitation pointing at an attacker's domain, and the recipient
# would hand over a valid one-time token by following it.
#
# Leave empty and the API returns the bare token with no link.
# ---------------------------------------------------------------------------
WEB_APP_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Frontend (apps/web)
#
# NEXT_PUBLIC_* is compiled into the browser bundle and is PUBLIC. Never put a
# secret here. This is the only variable the frontend needs.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ---------------------------------------------------------------------------
# Email — placeholder. Nothing sends mail yet.
# Setting SMTP_HOST without SMTP_PORT fails validation at boot: a
# half-configured integration is worse than an absent one.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# File storage (docs/FILE-STORAGE.md)
#
# local: files on the API host's disk (development, single instance).
# s3:    any S3-compatible store — AWS S3, MinIO, Cloudflare R2, Spaces…
# Default: s3 when S3_BUCKET is set, else local. Production refuses to start
# with neither, unless STORAGE_DRIVER=local is set deliberately.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
# Relative to the API's working directory (apps/api). Git-ignored.
STORAGE_LOCAL_ROOT=var/uploads
# Leave S3_ENDPOINT empty for AWS; set it for MinIO / R2 / Spaces.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Path-style URLs (endpoint/bucket/key). Default: true when S3_ENDPOINT is set.
S3_FORCE_PATH_STYLE=
# Optional CDN or public-bucket origin serving the public/ prefix. When set,
# public images redirect there instead of streaming through the API.
STORAGE_PUBLIC_BASE_URL=
# This API's public origin, used in the image and download URLs it hands out.
API_PUBLIC_URL=http://localhost:3000
FILE_MAX_IMAGE_BYTES=5242880
FILE_MAX_IMAGE_PIXELS=40000000
FILE_SIGNED_URL_TTL_SECONDS=300
FILE_CLEANUP_ENABLED=true
FILE_CLEANUP_INTERVAL_MS=600000
FILE_ORPHAN_GRACE_MINUTES=60

# ---------------------------------------------------------------------------
# Online payments — docs/PAYMENTS.md
#
# none   online payments off (in-person payments are still recorded)
# mock   local simulator with signed webhooks; refused in production
# qpay   QPay merchant API v2 (MNT only)
#
# Secrets come from here and nowhere else. Never commit real values.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=none
# >= 32 random characters. Signs webhook callback URLs, mock webhooks and
# public booking payment links:  openssl rand -base64 48
PAYMENT_SIGNING_SECRET=
# This API's public origin; providers deliver webhooks to
# <base>/api/v1/payments/webhook/<provider>. https:// in production.
PAYMENT_WEBHOOK_BASE_URL=
# QPay — issued with the merchant account. Sandbox: https://merchant-sandbox.qpay.mn
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=

# ---------------------------------------------------------------------------
# Test database
#
# The e2e suite runs TRUNCATE on every table between cases, so it MUST have its
# own database. `pnpm test:e2e` refuses to start if these are missing, or if
# they resolve to the same host+database as the development URLs above.
#
# Created for you by docker compose (see infrastructure/docker/postgres/init).
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://app_tenant:app_tenant_dev@localhost:5432/undarga_test?schema=public
TEST_PLATFORM_DATABASE_URL=postgresql://app_platform:app_platform_dev@localhost:5432/undarga_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/undarga_test?schema=public
