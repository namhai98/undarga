# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# NODE_ENV is deliberately NOT set here.
#
# Each tool sets its own: "next build" sets production, "next dev" sets
# development, jest sets test. Pinning it here made dotenv-cli force
# development into production builds. The API config schema defaults it to
# development, so local runs are unaffected.
PORT=3000
API_PREFIX=api
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
#
# Two URLs, two Postgres roles. This separation is a security control, not a
# convenience:
#
#   DATABASE_URL          -> app_tenant   : RLS ENFORCED. All request traffic.
#   PLATFORM_DATABASE_URL -> app_platform : BYPASSRLS. Platform module, tenant
#                                           directory lookups, worker claim
#                                           queries, migrations. Nothing else.
#
# Never point DATABASE_URL at the platform role. A startup check refuses to
# boot if the tenant role can bypass RLS.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://app_tenant:app_tenant_dev@localhost:5432/undarga?schema=public
PLATFORM_DATABASE_URL=postgresql://app_platform:app_platform_dev@localhost:5432/undarga?schema=public
# Used only by `prisma migrate` / `prisma db push`; owns the schema.
MIGRATION_DATABASE_URL=postgresql://undarga:undarga_dev@localhost:5432/undarga?schema=public

# Connection pooling. MUST be `transaction` when pgbouncer sits in front.
DB_POOLING_MODE=transaction

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
#
# NOTE: there is deliberately no JWT_REFRESH_SECRET. Refresh tokens are opaque
# 256-bit values stored as an HMAC (see TOKEN_HASH_PEPPER below), not JWTs, so
# they can be revoked server-side — a signed refresh JWT cannot be.
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# HMAC pepper for refresh tokens and gift-card codes. Rotating it invalidates
# every outstanding refresh token.
TOKEN_HASH_PEPPER=change-me-dev-only-pepper

# How long an invitation link stays valid.
INVITATION_TTL_DAYS=7

# Password policy. Length is what resists guessing; composition rules mostly
# produce "Password1!". 12 is also the floor — this cannot be set lower.
PASSWORD_MIN_LENGTH=12

# One-time link lifetimes. Reset is far shorter than verification because it
# takes over an account: a leaked inbox should be dangerous for minutes, not days.
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---------------------------------------------------------------------------
# Tenant resolution
#
# Resolvers run as a priority chain. The route param and the token's active
# company are always on. The two host-based strategies are wired but disabled:
# turning them on requires the DNS verification flow, which is not built yet.
# ---------------------------------------------------------------------------
TENANT_RESOLVER_ROUTE_PARAM=true
TENANT_RESOLVER_ACTIVE_COMPANY=true
TENANT_RESOLVER_HEADER=true
TENANT_RESOLVER_CUSTOM_DOMAIN=false
TENANT_RESOLVER_SUBDOMAIN=false
# Apex used to strip a subdomain, e.g. "acme.booking.local" -> slug "acme".
TENANT_SUBDOMAIN_ROOT=booking.local

# Membership + permission cache (in-memory by default; swap for Redis in prod).
TENANT_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# Audit
#
# Hash chaining makes tampering detectable but serializes audit writes per
# company behind an advisory lock. Benchmark before disabling.
# ---------------------------------------------------------------------------
AUDIT_HASH_CHAIN=true


# ---------------------------------------------------------------------------
# Availability
#
# Advisory response cache for the availability engine. 0 disables it, which is
# the default — the engine loads a bounded set of rows and computes in memory,
# so caching is a benchmark-driven optimisation, not a correctness need. If
# enabled, keep it SHORT: a slot list goes stale the moment an appointment is
# created.
# ---------------------------------------------------------------------------
AVAILABILITY_CACHE_TTL_SECONDS=0


# ---------------------------------------------------------------------------
# Notifications
#
# The in-process worker: outbox -> notifications -> providers, plus reminder
# scheduling. No real email/SMS/push provider is wired yet; messages are logged
# (fully in development, redacted elsewhere) and recorded as SENT.
# ---------------------------------------------------------------------------
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=15000

# ---------------------------------------------------------------------------
# Subscriptions
#
# The sweep that expires ended trials and cancelled periods, renews active
# ones (issuing the next invoice) and marks unpaid invoices past due.
# ---------------------------------------------------------------------------
SUBSCRIPTION_SWEEP_ENABLED=true
SUBSCRIPTION_SWEEP_INTERVAL_MS=3600000

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=undarga:
# When false the API starts without Redis and readiness reports it down.
# Forced true in production: rate limiting and booking holds fail OPEN without
# it, and a rate limiter that fails open is worse than one that refuses to boot.
REDIS_REQUIRED=false

# ---------------------------------------------------------------------------
# CORS
#
# Comma-separated exact origins. There is no wildcard. Empty means same-origin
# only; production refuses to boot with it empty.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# OpenAPI
# The document enumerates every route and error code. Turn it off in
# production unless the API is deliberately public.
# ---------------------------------------------------------------------------
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Web app origin
#
# Used to build the invitation accept link. Deliberately configured rather than
# derived from the request Host header: host-header injection would otherwise
# produce an invitation pointing at an attacker's domain, and the recipient
# would hand over a valid one-time token by following it.
#
# Leave empty and the API returns the bare token with no link.
# ---------------------------------------------------------------------------
WEB_APP_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Frontend (apps/web)
#
# NEXT_PUBLIC_* is compiled into the browser bundle and is PUBLIC. Never put a
# secret here. This is the only variable the frontend needs.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ---------------------------------------------------------------------------
# Email — placeholder. Nothing sends mail yet.
# Setting SMTP_HOST without SMTP_PORT fails validation at boot: a
# half-configured integration is worse than an absent one.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Object storage — placeholder. Nothing uploads yet.
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Payments — placeholder. Nothing charges yet.
# Provider stays "none" until the merchant-of-record decision in
# docs/DATABASE.md is settled.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=none
PAYMENT_API_KEY=

# ---------------------------------------------------------------------------
# Test database
#
# The e2e suite runs TRUNCATE on every table between cases, so it MUST have its
# own database. `pnpm test:e2e` refuses to start if these are missing, or if
# they resolve to the same host+database as the development URLs above.
#
# Created for you by docker compose (see infrastructure/docker/postgres/init).
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://app_tenant:app_tenant_dev@localhost:5432/undarga_test?schema=public
TEST_PLATFORM_DATABASE_URL=postgresql://app_platform:app_platform_dev@localhost:5432/undarga_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/undarga_test?schema=public
