# =============================================================================
# PRODUCTION environment — placeholders only. docs/DEPLOYMENT.md explains each.
#
# Copy to your secret manager or orchestrator (not into the repository, not
# into an image). Every `CHANGE_ME` must be replaced; the API refuses to start
# with several unsafe values (see apps/api/src/config/env.schema.ts).
# Optional settings and their defaults are documented in .env.example.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=production
PORT=3000
API_PREFIX=api
LOG_LEVEL=info
LOG_FORMAT=json
# Exact https origin(s) of the web app, comma-separated. No wildcards.
CORS_ORIGINS=https://app.example.com
# Proxies in front of the API (one load balancer = 1). Never "true".
TRUST_PROXY=1
# Where the web app lives (invitation and password-reset links).
WEB_APP_URL=https://app.example.com
# Public origin of this API (signed file URLs, webhooks).
API_PUBLIC_URL=https://api.example.com
# SWAGGER_ENABLED is off in production unless set to true.

# --- Database ----------------------------------------------------------------
# Three roles (docs/DATABASE.md): the app (RLS enforced), the platform (bypass,
# platform module only), and the schema owner (migrations only).
DATABASE_URL=postgresql://app_tenant:CHANGE_ME@db.example.internal:5432/undarga?schema=public&sslmode=require
PLATFORM_DATABASE_URL=postgresql://app_platform:CHANGE_ME@db.example.internal:5432/undarga?schema=public&sslmode=require
MIGRATION_DATABASE_URL=postgresql://undarga_owner:CHANGE_ME@db.example.internal:5432/undarga?schema=public&sslmode=require
# The same passwords as in DATABASE_URL / PLATFORM_DATABASE_URL — the migration
# job sets them on the roles (scripts/apply-hardening.js).
APP_TENANT_PASSWORD=CHANGE_ME
APP_PLATFORM_PASSWORD=CHANGE_ME
# transaction (behind PgBouncer in transaction mode) or none. Never session.
DB_POOLING_MODE=transaction

# --- Redis (rate limits, session revocation, caches) -------------------------
REDIS_URL=rediss://:CHANGE_ME@redis.example.internal:6379/0
REDIS_KEY_PREFIX=undarga:
REDIS_REQUIRED=true

# --- Auth secrets (random, long, unique per environment) ---------------------
# openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
TOKEN_HASH_PEPPER=CHANGE_ME_AT_LEAST_16_RANDOM_CHARACTERS
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored provider
# and calendar credentials; losing it makes them unreadable.
SECRETS_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# --- File storage --------------------------------------------------------------
# S3-compatible object storage (recommended), or STORAGE_DRIVER=local with a
# persistent volume mounted at STORAGE_LOCAL_ROOT.
STORAGE_DRIVER=s3
S3_BUCKET=CHANGE_ME
S3_REGION=CHANGE_ME
S3_ENDPOINT=
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

# --- Email / SMS (log and mock are refused in production) --------------------
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=CHANGE_ME
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Undarga
SENDGRID_WEBHOOK_PUBLIC_KEY=CHANGE_ME
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=CHANGE_ME
PUSH_PROVIDER=none
NOTIFICATION_WEBHOOK_BASE_URL=https://api.example.com

# --- Payments (mock is refused in production) ---------------------------------
PAYMENT_PROVIDER=qpay
PAYMENT_SIGNING_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
PAYMENT_WEBHOOK_BASE_URL=https://api.example.com
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_CLIENT_ID=CHANGE_ME
QPAY_CLIENT_SECRET=CHANGE_ME
QPAY_INVOICE_CODE=CHANGE_ME

# --- Calendar integration (optional; set both halves of a pair or neither) ----
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
CALENDAR_OAUTH_REDIRECT_URL=https://app.example.com/calendar/callback

# --- Web app (build argument of the web image, not a runtime variable) --------
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
