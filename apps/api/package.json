{
  "name": "@undarga/api",
  "version": "0.1.0",
  "private": true,
  "description": "Booking platform API — NestJS modular monolith",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "pnpm start:dev",
    "clean": "rimraf dist coverage",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:e2e": "dotenv -e ../../.env -- jest --config jest.e2e.config.js --runInBand",
    "test:isolation": "dotenv -e ../../.env -- jest --config jest.e2e.config.js --runInBand -t \"tenant isolation\"",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy && pnpm db:harden",
    "db:harden": "dotenv -e ../../.env -- node scripts/apply-hardening.js",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force && pnpm db:harden && pnpm db:seed",
    "db:seed": "dotenv -e ../../.env -- ts-node prisma/seed.ts",
    "db:seed:demo": "dotenv -e ../../.env -- ts-node scripts/seed-demo.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "helmet": "8.0.0",
    "ioredis": "5",
    "nestjs-zod": "5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.6",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "@undarga/eslint-config": "workspace:^",
    "@undarga/shared": "workspace:^",
    "@undarga/tsconfig": "workspace:^",
    "dotenv-cli": "7.4.2",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "pg": "8.13.1",
    "prettier": "3.3.3",
    "prisma": "5.22.0",
    "rimraf": "6.0.1",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3"
  }
}
