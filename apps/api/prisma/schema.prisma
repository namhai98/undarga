// =============================================================================
//  PROPOSED PRISMA SCHEMA — Multi-Tenant SaaS Booking Platform
// =============================================================================
//  STATUS: DESIGN PROPOSAL. Not wired to any build, package manifest, or
//  migration runner. Awaiting sign-off on the blocking decisions in
//  docs/DATABASE.md before it moves to prisma/schema.prisma.
//
//  This schema has NOT been machine-validated (`prisma validate` / `prisma
//  format` have not been run — no Node toolchain is installed in this repo
//  yet). Constructs to verify on first validation are listed at the end of
//  docs/DATABASE.md §18.4.
//
//  CONVENTIONS
//    • PascalCase models, snake_case tables/columns via @@map / @map
//    • id  : UUIDv7 (sortable, non-enumerable) — requires Prisma >= 5.14
//    • Every tenant model carries `companyId` + @@unique([companyId, id])
//      so that child rows can use COMPOSITE foreign keys (companyId, xId)
//      -> (companyId, id). A cross-tenant reference is then unrepresentable.
//    • A direct `company` relation is declared only on models whose parent IS
//      Company. Grandchildren (e.g. AppointmentItem) reach Company transitively
//      through their composite FK, so a second FK would be redundant.
//    • Referential actions on tenant relations are NoAction/NoAction because
//      `companyId` participates in several relations on the same model.
//      Postgres NO ACTION still blocks orphaning deletes.
//    • Money: BigInt minor units + ISO-4217 currency code. Scale comes from
//      currency.minor_unit — never hardcoded, and never a float.
//    • Instants: @db.Timestamptz(3). Recurring wall-clock rules: @db.Time(0).
//    • Soft delete: presence of `deletedAt` marks a soft-deletable model.
//
//  NOT EXPRESSIBLE IN PRISMA — see docs/proposed/001_hardening.sql
//    RLS policies · EXCLUDE USING gist · generated columns · partial unique
//    indexes · CHECK constraints · triggers · table partitioning
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist, pg_trgm, citext]
}

// =============================================================================
//  ENUMS
// =============================================================================

