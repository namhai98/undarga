/// Lifecycle of a booking. Deliberately independent of AppointmentPaymentStatus.
/// HOLD and EXPIRED are additions to the seven required states: HOLD is what
/// lets the exclusion constraint protect a slot while the customer pays.
enum AppointmentStatus {
  HOLD
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED

  @@map("appointment_status")
}

/// Money state of a booking. NEVER merged with AppointmentStatus — every
/// combination of the two is a real situation (see docs/DATABASE.md §5.3).
enum AppointmentPaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOID

  @@map("appointment_payment_status")
}

enum BookingSource {
  ONLINE
  WALK_IN
  PHONE
  STAFF
  API
  IMPORT

  @@map("booking_source")
}

enum ActorType {
