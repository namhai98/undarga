{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"]
    }
  },
  // Standalone scripts (seed, demo fixtures) run through ts-node, which needs
  // CommonJS regardless of what a future ESM migration does to the build.
  "ts-node": {
    "compilerOptions": { "module": "commonjs" },
    "transpileOnly": false
  },
  "include": ["src/**/*", "test/**/*", "prisma/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
